{
  "name": "marineteam/marine-video-portal-php",
  "description": "Private invite-only video portal - PHP port with WordPress-style installer",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "guzzlehttp/guzzle": "^7.8",
    "firebase/php-jwt": "^6.11.1",
    "phpmailer/phpmailer": "^6.9.3"
  },
  "autoload": {
    "psr-4": {
      "MarinePortal\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {},
    "audit": {
      "abandoned": "ignore",
      "block": false,
      "ignore": [
        "PKSA-y2cr-5h3j-g3ys"
      ]
    }
  }
}